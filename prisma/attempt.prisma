model ExerciseAttempt {
  id              String                  @id @default(cuid())
  score           Int                     @default(0)
  maxScore        Int                     @default(0)
  correctCount    Int                     @default(0)
  incorrectCount  Int                     @default(0)
  unansweredCount Int                     @default(0)
  essayCount      Int                     @default(0)
  answeredCount   Int                     @default(0)
  totalQuestions  Int                     @default(0)
  submittedAt     DateTime                @default(now())
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  exerciseId      String
  userId          String
  exercise        Exercise                @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers         ExerciseAttemptAnswer[]

  @@index([exerciseId, submittedAt])
  @@index([userId, submittedAt])
}

model ExerciseAttemptAnswer {
  id              String          @id @default(cuid())
  selectedOptions String?         @db.Text
  essayAnswer     String?         @db.Text
  isCorrect       Boolean?
  awardedPoints   Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  attemptId       String
  questionId      String
  attempt         ExerciseAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}
