model Topic {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  category    String
  difficulty  String
  summary     String?     @db.Text
  status      TopicStatus @default(DRAFT)
  previewMode AccessLevel
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  materials   Material[]
  exercises   Exercise[]

  @@index([category])
}

model Material {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  type        MaterialType
  status      TopicStatus  @default(DRAFT)
  accessLevel AccessLevel
  fileName    String?
  coverName   String?
  filePath    String?
  coverPath   String?
  fileUrl     String?      @db.Text
  coverUrl    String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  topicId     String
  topic       Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  exercises   Exercise[]

  @@index([topicId])
}
