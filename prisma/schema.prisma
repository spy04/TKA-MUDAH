generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TopicStatus {
  DRAFT
  PUBLISHED
}

enum AccessLevel {
  PREVIEW
  ENROLLED
}

enum MaterialType {
  VIDEO
  PDF
  SLIDE
  DOCUMENT
}

enum AnswerKey {
  A
  B
  C
  D
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  ESSAY
}

enum UserRole {
  ADMIN
  STUDENT
}

model Topic {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  category    String
  difficulty  String
  summary     String?     @db.Text
  status      TopicStatus @default(DRAFT)
  previewMode AccessLevel
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  materials   Material[]
  exercises   Exercise[]

  @@index([category])
}

model Material {
  id          String       @id @default(cuid())
  title       String
  description String?      @db.Text
  type        MaterialType
  status      TopicStatus  @default(DRAFT)
  accessLevel AccessLevel
  fileName    String?
  coverName   String?
  filePath    String?
  coverPath   String?
  fileUrl     String?      @db.Text
  coverUrl    String?      @db.Text
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  topicId     String
  topic       Topic        @relation(fields: [topicId], references: [id], onDelete: Cascade)
  exercises   Exercise[]

  @@index([topicId])
}

model Exercise {
  id            String      @id @default(cuid())
  title         String
  questionCount Int?
  status        TopicStatus @default(DRAFT)
  accessLevel   AccessLevel
  adminNotes    String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  topicId       String
  topic         Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  materialId    String?
  material      Material?   @relation(fields: [materialId], references: [id], onDelete: SetNull)
  questions     Question[]
  attempts      ExerciseAttempt[]

  @@index([topicId])
  @@index([materialId])
}

model Question {
  id             String       @id @default(cuid())
  questionType   QuestionType @default(SINGLE_CHOICE)
  prompt         String       @db.Text
  optionA        String?      @db.Text
  optionB        String?      @db.Text
  optionC        String?      @db.Text
  optionD        String?      @db.Text
  optionE        String?      @db.Text
  correctAnswer  AnswerKey?
  correctAnswers String?      @db.Text
  sampleAnswer   String?      @db.Text
  explanation    String?      @db.Text
  points         Int          @default(10)
  orderNumber    Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  exerciseId     String
  exercise       Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  attemptAnswers ExerciseAttemptAnswer[]

  @@index([exerciseId])
  @@unique([exerciseId, orderNumber])
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
  exerciseAttempts ExerciseAttempt[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ExerciseAttempt {
  id                 String                  @id @default(cuid())
  score              Int                     @default(0)
  maxScore           Int                     @default(0)
  correctCount       Int                     @default(0)
  incorrectCount     Int                     @default(0)
  unansweredCount    Int                     @default(0)
  essayCount         Int                     @default(0)
  answeredCount      Int                     @default(0)
  totalQuestions     Int                     @default(0)
  submittedAt        DateTime                @default(now())
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
  exerciseId         String
  userId             String
  exercise           Exercise                @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers            ExerciseAttemptAnswer[]

  @@index([exerciseId, submittedAt])
  @@index([userId, submittedAt])
}

model ExerciseAttemptAnswer {
  id              String           @id @default(cuid())
  selectedOptions String?          @db.Text
  essayAnswer     String?          @db.Text
  isCorrect       Boolean?
  awardedPoints   Int              @default(0)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  attemptId       String
  questionId      String
  attempt         ExerciseAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question        Question         @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}
